{
  "name": "sodhnus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "sh scripts/migrate.sh",
    "ml": "uv run --project ml sodhnus",
    "sources": "uv run --project ml sodhnus sources",
    "crawl": "uv run --project ml sodhnus crawl",
    "evals": "tsx --import ./evals/assets.mjs evals/run.ts",
    "ml:serve": "uv run --project ml sodhnus serve",
    "test:ml": "uv run --project ml pytest ml/tests -q"
  },
  "dependencies": {
    "motion": "^13.4.6",
    "nepali-date-converter": "^3.4.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
