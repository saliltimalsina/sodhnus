# Copy to .env.local. Everything here runs on free tiers.

# Postgres with pgvector. Locally: `createdb sodhnus`; in production: a Neon or Supabase free project.
DATABASE_URL=postgresql://localhost:5432/sodhnus

# Cloudflare Workers AI (free daily allowance): embeddings, reranking and the answer model.
# Needed from Phase 1 on. Create a token with the "Workers AI" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
