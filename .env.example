# Copy to .env.local. Everything here runs on free, open-source software or free tiers.

# Postgres with pgvector. Locally: `createdb sodhnus`; in production: a Neon free project.
DATABASE_URL=postgresql://localhost:5432/sodhnus

# The search API from ml/ (`npm run ml:serve`). Set ML_TOKEN on both sides when it is public.
ML_URL=http://127.0.0.1:8765
ML_TOKEN=

# Any OpenAI-compatible chat endpoint. Default: Ollama on this machine with Gemma 3 12B.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma3:12b
LLM_API_KEY=
